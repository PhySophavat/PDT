{
  "version": 2,
  "framework": null,
  "buildCommand": "cd PDT && npm run build",
  "outputDirectory": "PDT/public",
  "functions": {
    "PDT/api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "headers": [
    {
      "source": "/build/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/PDT/public/build/$1"
    },
    {
      "src": "/(favicon.ico|robots.txt)",
      "dest": "/PDT/public/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/PDT/public/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/PDT/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_KEY": "base64:9EvsufK6IKWmF5ATdQATWq+eqjUFEp/rO/6sshb3MtI=",
    "APP_CONFIG_CACHE": "/tmp/bootstrap/cache/config.php",
    "APP_EVENTS_CACHE": "/tmp/bootstrap/cache/events.php",
    "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
    "APP_ROUTES_CACHE": "/tmp/bootstrap/cache/routes.php",
    "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "database",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_SAME_SITE": "lax",
    "LOG_CHANNEL": "stderr",
    "DB_CONNECTION": "mysql",
    "DB_HOST": "gateway01.ap-southeast-1.prod.aws.tidbcloud.com",
    "DB_PORT": "4000",
    "DB_DATABASE": "pdt",
    "DB_USERNAME": "3mw5PACCeLp6Wb8.root",
    "DB_PASSWORD": "H5GamPQkivCPJqR9",
    "DB_SSL": "true",
    "MYSQL_ATTR_SSL_CA": "PDT/storage/certs/ca.pem",
    "MYSQL_ATTR_SSL_VERIFY_SERVER_CERT": "false"
  }
}
