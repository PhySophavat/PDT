{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "postinstall": "node node_modules/esbuild/install.js || true",
        "build": "node -e \"const fs=require('fs'); fs.writeFileSync('public/version.json', JSON.stringify({version: Date.now().toString(36), time: new Date().toISOString(), commit: process.env.VERCEL_GIT_COMMIT_SHA || ''}));\" && vite build",
        "dev": "vite"
    },
    "allowScripts": {
        "esbuild": true,
        "tesseract.js": true
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.10",
        "lucide-vue-next": "^1.0.0",
        "pinia": "^4.1.0",
        "qrcode": "^1.5.4",
        "tesseract.js": "^7.0.0",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.16",
        "vue-router": "^5.4.0",
        "xlsx": "^0.18.5"
    }
}
